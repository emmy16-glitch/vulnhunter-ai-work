ARG PYTHON_BASE_IMAGE=python:3.12-slim-bookworm
FROM ${PYTHON_BASE_IMAGE}

ARG BANDIT_VERSION=1.9.4

LABEL org.opencontainers.image.title="VulnHunter OpenSandbox Bandit Worker" \
      org.opencontainers.image.description="Offline, non-root Bandit worker for governed VulnHunter source-file scans" \
      org.opencontainers.image.source="https://github.com/emmy16-glitch/vulnhunter-ai-work" \
      org.opencontainers.image.licenses="Apache-2.0"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/tmp

RUN python -m pip install --no-cache-dir "bandit==${BANDIT_VERSION}" \
    && /usr/local/bin/bandit --version

WORKDIR /tmp
USER 65532:65532

# OpenSandbox keeps the workload alive while execd handles bounded commands.
# The scanner itself is never the container entrypoint and receives only the
# immutable argv prepared by VulnHunter's fixed adapter.
CMD ["python3", "-c", "import time; time.sleep(86400)"]
